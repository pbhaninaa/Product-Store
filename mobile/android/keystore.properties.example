# Copy to keystore.properties (gitignored) and fill in real values.
# Generate a keystore once, then keep these credentials safe: Play Store updates need the same key.
#
# keytool -genkeypair -v -storetype PKCS12 \
#   -keystore app/productstore-release.keystore \
#   -alias productstore \
#   -keyalg RSA -keysize 2048 -validity 10000

storeFile=productstore-release.keystore
storePassword=REPLACE_ME
keyAlias=productstore
keyPassword=REPLACE_ME
